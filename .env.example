AEGIS_ENV=development
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8000
AEGIS_ALLOWED_ORIGINS=chrome-extension://*,http://127.0.0.1:8000,http://localhost:8000
AEGIS_RATE_LIMIT=100/minute
